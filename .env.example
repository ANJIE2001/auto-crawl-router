# 环境文件模板 —— 复制成 .env 再填真值。
#
#   copy .env.example .env        （Windows CMD）
#   cp .env.example .env          （Git Bash / PowerShell）
#
# .env 已在 .gitignore 里排除；打包发人时也必须排除 —— 见 05_技能/打包排除清单.md
# 格式：KEY=VALUE，一行一个；# 开头是注释；值不要加引号。
#
# 想知道「这些软件装了没、key 配了没」，跑：
#   python 05_技能/prereq_check.py

# ---- 得到大脑（开放平台 HTTP API，不花钱）----
# 两个值缺一不可：开放平台 → 创建应用 → 生成 API Key，会同时给你 Client ID 和 API Key
# 权限建议：只抓外部内容的话，勾 topic.read + topic.blogger.read 就够；
#          带 note. 前缀的一个都别勾（那是私人笔记）
GETNOTE_CLIENT_ID=
GETNOTE_API_KEY=
GETNOTE_BASE_URL=https://openapi.biji.com/open/api/v1

# ---- 灵造（走 CLI，花钱）----
# 凭证平时存在 ~/.lingzao/config.json，由 CLI 自己管，这里留空就行。
# 只有想给本项目单独用一个 key 时才填，例：LINGZAO_API_KEY=lgz_xxxx
LINGZAO_API_KEY=
LINGZAO_BASE_URL=

# ---- 浏览器兜底（CDP，暂未实现，先留着）----
CHROME_CDP_PORT=9222
CHROME_USER_DATA_DIR=

# ---- 路径（相对项目根，一般不用改；当前版本代码按目录结构自动推断）----
STORE_ROOT=02_储存
OUTPUT_ROOT=04_产出
