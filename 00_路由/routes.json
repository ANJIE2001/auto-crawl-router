{
  "version": "1.0",
  "updated": "2026-09-19",
  "fallback_route": "fallback",
  "routes": {
    "batch_search": {
      "source": "lingzao",
      "command": "search-notes",
      "store_dir": "02_储存/01_lingzao/search-notes",
      "cost": "20 credits/次",
      "output": ["json", "md"],
      "note": "按关键词批量搜笔记，出的是列表，不下钻单条详情"
    },
    "deep_profile": {
      "source": "lingzao",
      "command": "analyze-user-profile",
      "store_dir": "02_储存/01_lingzao/analyze-user-profile",
      "cost": "100 credits/博主",
      "output": ["json", "md"],
      "note": "单博主全量笔记 + 字幕。字幕是截断预览，完整字幕在 artifacts.subtitle_markdown"
    },
    "subscription": {
      "source": "getnote",
      "command": "getnote-kb / getnote-note",
      "store_dir": "02_储存/02_getnote",
      "cost": "Pro 会员 299/年",
      "output": ["md"],
      "note": "追踪指定博主更新，自动出逐字稿 + 原链接"
    },
    "collection": {
      "source": "getnote",
      "command": "getnote-note",
      "store_dir": "02_储存/02_getnote",
      "cost": "Pro 会员 299/年",
      "output": ["md"],
      "note": "手动收进知识库的内容归档"
    },
    "fallback": {
      "source": "browser",
      "command": "cdp-scrape",
      "store_dir": "02_储存/03_browser",
      "cost": "0（自备 Chrome）",
      "output": ["json"],
      "note": "灵造、得到大脑都不可用时的兜底。走 __INITIAL_STATE__，比 DOM 选择器准"
    }
  },
  "sources": {
    "lingzao": {
      "label": "灵造",
      "kind": "paid_api",
      "adapter": "03_加工/adapters/ad_lingzao.py"
    },
    "getnote": {
      "label": "得到大脑",
      "kind": "paid_subscription",
      "adapter": "03_加工/adapters/ad_getnote.py（待写）"
    },
    "browser": {
      "label": "浏览器 CDP",
      "kind": "local",
      "adapter": "03_加工/adapters/ad_browser.py（待写）",
      "legacy_scripts": [
        "03_加工/scripts/process_browser_notes.py",
        "03_加工/scripts/build_notes_excel.py"
      ]
    },
    "api_x": {
      "label": "第三方裸 API",
      "kind": "reserved",
      "adapter": "03_加工/adapters/ad_api_x.py（待写）",
      "note": "预留位。目前还没选到合适的服务商"
    }
  },
  "legacy_scripts": {
    "merge_rounds.py": "多轮 CDP 搜索结果合并分析（一次性脚本，留作参考）",
    "extract_profile_notes.py": "profile JSON → 逐条笔记 .md",
    "download_covers.py": "批量下载封面并回写 md 字段",
    "process_browser_notes.py": "浏览器 CDP JSON → 逐条笔记 .md",
    "build_notes_excel.py": "profile/浏览器 JSON → 24 字段 Excel 模板"
  }
}
